{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "ArenaKit native dock (bundled UI): full access to the app commands, incl. evaluating JS in the arena.ai webview.",
  "windows": ["main"],
  "webviews": ["dock"],
  "permissions": [
    "core:default",
    "http:default",
    "allow-arena-command",
    "allow-page-event",
    "allow-proxy-get",
    "allow-store-get",
    "allow-store-set",
    "allow-store-keys"
  ]
}
