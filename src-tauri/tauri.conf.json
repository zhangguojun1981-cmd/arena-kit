{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArenaKit",
  "version": "0.1.0",
  "identifier": "com.ati.arenakit",
  "build": {
    "frontendDist": "../src",
    "devUrl": "https://arena.ai"
  },
  "app": {
    "windows": [
      {
        "title": "ArenaKit",
        "url": "https://arena.ai",
        "width": 1280,
        "height": 860,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}
