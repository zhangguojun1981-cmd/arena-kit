{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArenaKit",
  "version": "0.3.0",
  "identifier": "com.ati.arenakit",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": [
        "default",
        "arena-page",
        "arena-page-mobile"
      ]
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}
